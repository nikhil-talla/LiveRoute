# Empty uses same-origin /api/v1 in production. Local development uses the
# contractually allowed loopback backend origin.
VITE_LIVEROUTE_API_ORIGIN=http://localhost:8080

# Public browser identifiers/tokens. Never place the server-side Permanent
# Geocoding token or any LiveRoute session/HMAC secret here.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_MAPBOX_PUBLIC_ACCESS_TOKEN=

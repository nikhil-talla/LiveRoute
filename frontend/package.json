{
  "name": "liveroute-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "generate:api": "openapi-typescript ../schema/http/liveroute-v1.5.openapi.yaml --output src/generated/liveroute-api.ts",
    "check:generated": "node scripts/check-generated-api.mjs",
    "check": "npm run check:generated && npm run lint && npm run format:check && npm run test && npm run build && npm run audit"
  },
  "dependencies": {
    "@mapbox/search-js-react": "1.6.0",
    "mapbox-gl": "3.28.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}

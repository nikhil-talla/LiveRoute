{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liveroute.local/schema/hours/liveroute-v1-hours-seed.schema.json",
  "title": "LiveRoute V1 seeded operating hours",
  "type": "object",
  "required": ["schema_version", "tzdata_release", "places"],
  "properties": {
    "schema_version": { "const": 1 },
    "tzdata_release": { "type": "string", "pattern": "^[0-9]{4}[a-z]$" },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/placeHours" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "localTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
    },
    "recurringInterval": {
      "type": "object",
      "required": ["opens_at_local", "closes_at_local", "closes_day_offset"],
      "properties": {
        "opens_at_local": { "$ref": "#/$defs/localTime" },
        "closes_at_local": { "$ref": "#/$defs/localTime" },
        "closes_day_offset": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "exceptionInterval": {
      "type": "object",
      "required": ["opens_at_local", "closes_at_local", "closes_day_offset"],
      "properties": {
        "opens_at_local": { "$ref": "#/$defs/localTime" },
        "closes_at_local": { "$ref": "#/$defs/localTime" },
        "closes_day_offset": { "type": "integer", "minimum": 0, "maximum": 1 },
        "opens_utc_offset_seconds": {
          "type": "integer",
          "minimum": -64800,
          "maximum": 64800
        },
        "closes_utc_offset_seconds": {
          "type": "integer",
          "minimum": -64800,
          "maximum": 64800
        }
      },
      "additionalProperties": false
    },
    "weeklyHours": {
      "type": "object",
      "required": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "properties": {
        "monday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "tuesday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "wednesday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "thursday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "friday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "saturday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        },
        "sunday": {
          "type": "array",
          "items": { "$ref": "#/$defs/recurringInterval" }
        }
      },
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "required": ["local_date", "intervals"],
      "properties": {
        "local_date": { "$ref": "#/$defs/localDate" },
        "intervals": {
          "type": "array",
          "items": { "$ref": "#/$defs/exceptionInterval" }
        }
      },
      "additionalProperties": false
    },
    "placeHours": {
      "type": "object",
      "required": [
        "place_id",
        "time_zone_name",
        "weekly",
        "exceptions"
      ],
      "properties": {
        "place_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "time_zone_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "weekly": { "$ref": "#/$defs/weeklyHours" },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        }
      },
      "additionalProperties": false
    }
  }
}
